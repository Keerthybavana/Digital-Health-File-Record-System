# ==============================================================================
# Digital Health File Record System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific settings.
# NEVER commit the actual '.env' file or expose production secrets to Git.
# ==============================================================================

# Application Environment: 'development' or 'production'
# In production, setting this to 'production' enforces strict security checks.
ENVIRONMENT=development

# Flask Secret Key
# REQUIRED in production. Must be a strong, cryptographically secure random string.
# Example command to generate a key: python -c "import secrets; print(secrets.token_hex(32))"
# In development, if omitted, a safe development-only fallback key is used.
SECRET_KEY=

# Flask Debug Mode: 'true' or 'false'
# MUST remain 'false' in production. The application will permanently disable debug
# mode when ENVIRONMENT is set to 'production', even if this flag is set to 'true'.
FLASK_DEBUG=false